# Copy this file to ".env" and fill in your values. Never share or commit the real .env.

# development: opens /docs and allows any website (CORS "*"). Anything else, or nothing, means
# production: docs off, CORS limited.
ENV=development

# Your Firebase project id (Firebase console > Project settings). Used to check login tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Websites allowed to call the API from a browser (production only). Empty is fine for the Android app.
ALLOWED_ORIGINS=

# Primary AI: Groq (free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional backup AI: Z.ai GLM. Leave ZAI_API_KEY empty to skip the backup.
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash
