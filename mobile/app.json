{
  "expo": {
    "name": "HisaabKitaab AI",
    "slug": "hisaabkitaab-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.hawkai.hisaabkitaab",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F12"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": [
              "en",
              "ur"
            ],
            "ios": [
              "en",
              "ur"
            ]
          }
        }
      ]
    ],
    "scheme": "hisaabkitaab",
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "ff288c4e-6bbe-4b73-a960-d79823215c31"
      }
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "owner": "hashir-08",
    "backgroundColor": "#0E0F12"
  }
}
