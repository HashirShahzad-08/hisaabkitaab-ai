// Firestore security rules for HisaabKitaab AI.
// A signed-in user can read and write only their own data under users/{uid}.
// Everything else is denied: Firestore refuses any request that no rule below allows.
// Publish with the Firebase console (Firestore Database > Rules) or the Firebase CLI.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
